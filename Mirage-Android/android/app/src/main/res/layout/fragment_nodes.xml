<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/meow_canvas"
    android:padding="16dp">

    <!-- 顶栏标题与快捷操作 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="节点管理"
            android:textColor="@color/meow_ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportClipboard"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:paddingHorizontal="10dp"
            android:text="剪贴板导入"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/meow_blue" />
    </LinearLayout>

    <!-- 节点列表 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="8dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerNodes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            tools:listitem="@layout/item_node" />

        <TextView
            android:id="@+id/tvEmptyNodes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="暂无节点，点击下方「添加节点」或「剪贴板导入」"
            android:textColor="@color/meow_ink_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 主操作按钮组: 添加节点 / 一键测速 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addNodeBtn"
            style="@style/MirageButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="添加节点"
            android:textSize="14sp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestAll"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="一键测速"
            android:textSize="14sp"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- 节点与高级参数配置栏: 自动优选 / 测速方法 / 并发连接池 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/autoSelectBtn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="自动优选: 关"
            android:textSize="11sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/meow_outline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/testMethodBtn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="测速: TCP"
            android:textSize="11sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/meow_outline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPoolSize"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="连接池: 8"
            android:textSize="11sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/meow_outline" />
    </LinearLayout>
</LinearLayout>
