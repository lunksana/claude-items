# Backend
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://weixin:weixin@localhost:5432/weixin
SECRET_KEY=change-me-in-production

# WeChat Mini Program
WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_SECRET=

# WeChat Pay v3
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_PATH=
WECHAT_PAY_NOTIFY_URL=

# Object storage (local MinIO in dev; cloud -> COS/OSS via S3-compatible API)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=weixin-dev
S3_REGION=us-east-1

# Commission rates — 二级分销 cap (two tiers max). See CLAUDE.md red-line section.
COMMISSION_TIER1_RATE=0.10
COMMISSION_TIER2_RATE=0.05
