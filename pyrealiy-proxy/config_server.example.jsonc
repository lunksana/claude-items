// ─────────────────────────────────────────────────────────────────────────────
//  PyRealiy 服务端配置示例
//
//  用法：去掉所有注释，复制为 config_server.json
//        或：bash install.sh 用向导生成
//
//  注意：服务端当前仍用 schema_v0 平铺格式（不写 schema_version 字段）。
//        client.json 用 schema_version=1 的新格式（见 config_client.example.jsonc）。
// ─────────────────────────────────────────────────────────────────────────────
{
    // ═══════════════════════════════════════════════════════
    //   网络监听
    // ═══════════════════════════════════════════════════════

    // 监听地址。0.0.0.0 = 所有网卡，127.0.0.1 = 仅本机（仅开发/测试用）
    "listen_host": "0.0.0.0",

    // 监听端口。建议 443（与真实 HTTPS 同端口最难识别）；
    // 也可用 8443 / 自定义端口（客户端的 server_port 必须一致）
    "listen_port": 443,


    // ═══════════════════════════════════════════════════════
    //   鉴权
    // ═══════════════════════════════════════════════════════

    // 共享密码，与客户端 password 字段必须完全一致。
    // 建议至少 24 字符随机串：openssl rand -base64 24
    "password": "<your-strong-password-here>",


    // ═══════════════════════════════════════════════════════
    //   TLS 1.3 伪装
    // ═══════════════════════════════════════════════════════

    // 服务端启动时会从此域名拉真实 TLS 1.3 握手记录，构建握手缓存池
    // 用于反 GFW 主动探测（探测包到来时回放真实站点的响应）。
    //
    // 必须是 **支持 TLS 1.3 + ALPN h2** 的真实站点。
    // 推荐：www.apple.com（CDN 稳定）、www.bing.com、www.microsoft.com
    //
    // 客户端的 sni 字段必须与此一致，否则握手匹配失败。
    // install.sh 会用 `openssl s_client -tls1_3` 实测能不能用。
    "camouflage_host": "www.apple.com",

    // 伪装站点的端口。99% 情况是 443，少数自建站点用别的端口
    "camouflage_port": 443,


    // ═══════════════════════════════════════════════════════
    //   反 DoS / 连接保护
    // ═══════════════════════════════════════════════════════

    // 客户端连接闲置多久就主动关闭（秒）。默认 1800（30 分钟）
    // 太短会断长连接；太长会让僵尸连接占用 fd
    "idle_timeout_sec": 1800,

    // 单 IP 最大同时连接数（防单点 DoS）。默认 100
    // 正常浏览器 + 多标签很难撞到 100；爬虫共享 VPS 时按需调
    "max_conns_per_ip": 100,

    // TCP keepalive：服务端开启后能感知半死连接并主动回收
    // 默认 true；关掉只在嵌入式 / 低内存场景考虑
    "tcp_keepalive": true,


    // ═══════════════════════════════════════════════════════
    //   时钟同步（防 VPS 时钟漂移导致 token 重放校验失败）
    // ═══════════════════════════════════════════════════════

    // 双源 median：UDP NTP 优先；UDP 被防火墙拦时回落 HTTPS Date
    // 默认全开，正常 VPS 不用动；启动期 ≤ 5s 阻塞做首次同步
    "time_sync": {
        "enabled":         true,
        "interval":        "1h",          // 周期重同步
        "startup_timeout": "5s",          // 首次同步超时（超时后台重试）
        "max_offset_sec":  86400          // > 1 天的偏移视为污染，拒绝
        // "udp_servers": ["time.google.com:123", "pool.ntp.org:123"],   // 默认值已含国内外
        // "tcp_servers": ["https://www.cloudflare.com", "https://www.apple.com"]
    },


    // ═══════════════════════════════════════════════════════
    //   高级网络调优（可选；家用默认值即可）
    // ═══════════════════════════════════════════════════════

    // 服务端逐连接 dispatch INFO 日志开关（与 client 端 access_log 类似）
    // 调试规则匹配时开，生产关
    "access_log": false,

    // tunnel 写缓冲积压超过此值才 drain（bytes）。默认 64KB
    // 跨境长肥管道（高 BDP）调到 256KB-1MB 能让 pipeline 填满
    // 代价：内存上升、bufferbloat 可能恶化短包延迟
    "drain_threshold": 65536,


    // ═══════════════════════════════════════════════════════
    //   多出口分流（可选；WARP / 多 WireGuard / 多 ISP 场景）
    // ═══════════════════════════════════════════════════════

    // 不同出口走不同 SO_MARK 让内核策略路由选择物理出接口
    // 需配合 `ip rule add fwmark {mark} table {table}` + `ip route ... table {table}`
    "egresses": [
        // {"name": "warp",   "type": "marked", "mark": 100},
        // {"name": "us-wg",  "type": "marked", "mark": 101}
    ],

    // 出口分流规则（与客户端 route.rules 同 schema）
    // 决定哪些目标走哪个 egress；未命中走默认（直连服务端公网 IP）
    "egress_rules": [
        // {"domain_suffix": ["netflix.com", "disneyplus.com"], "egress": "us-wg"},
        // {"geoip": ["loyalsoldier:cn"], "egress": "warp"}
    ],


    // ═══════════════════════════════════════════════════════
    //   TCP Brutal（可选）
    // ═══════════════════════════════════════════════════════

    // Brutal 拥塞控制：单连接固定发送速率（bytes/sec），0 = 禁用。
    //
    // 仅在已安装 tcp_brutal 内核模块且想绕过 BBR/Cubic 拥塞调节时设。
    // 计算公式：上行带宽 Mbps × 1_000_000 / 8。
    // 示例：100 Mbps → 12500000；10 Mbps → 1250000
    //
    // 多客户端共享时会按比例瓜分服务端带宽。
    "brutal_rate_bps": 0,


    // ═══════════════════════════════════════════════════════
    //   服务端 Web 管理面板（可选；与客户端的 Clash API 是独立的东西）
    // ═══════════════════════════════════════════════════════

    // 服务端内嵌一个轻量 HTTP 面板（活跃连接 / 流量 / 封锁 IP / 域名分布）。
    // 留 0 / 空 即禁用。
    //
    // 安全：admin_host 建议保持 127.0.0.1，用 SSH 端口转发查看。
    // 暴露到公网必须设强 admin_token。
    "admin_host":  "127.0.0.1",
    "admin_port":  0,
    "admin_token": "",


    // ═══════════════════════════════════════════════════════
    //   日志（可选；schema_v1 风格 sub-object，server 也支持）
    // ═══════════════════════════════════════════════════════

    // 输出格式："text"（默认人类可读）或 "json"（每行一个 JSON，Loki/ELK 友好）
    "log": {"format": "text"},

    // 模块级日志覆盖。可用 logger 名见 core/utils.py::apply_log_levels 文档。
    "log_levels": {
        // "outbound": "DEBUG",     // 启用 outbound 中继 leg 异常 + 组切换日志
        // "handshake_cache": "DEBUG",
        // "camouflage": "DEBUG"
    }
}
